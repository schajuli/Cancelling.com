{
  "manifest_version": 3,
  "name": "Cancelling",
  "version": "1.3.0",
  "description": "Booking.com hides your free-cancellation deadlines behind tooltips. This extension puts them next to the price.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.booking.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.booking.com/mytrips*"
      ],
      "js": [
        "room.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.booking.com/confirmation*",
        "https://*.booking.com/mybooking*"
      ],
      "js": [
        "room.js",
        "quiet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cancelling@local",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cancelling",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "help.html",
    "open_in_tab": true
  }
}